irc:
  host: irc.example.net
  port: 6697
  tls: true
  tls_verify: true
  # bindhost: "192.168.1.100"  # optional local address for outbound IRC
  nick: pybot
  altnick: pybot_          # tried if primary nick is taken
  username: pybot
  realname: pybot
  # password: server-password  # optional PASS before registration
  oidentd:
    enabled: false
    path: ~/.config/oidentd.conf  # or ~/.oidentd.conf for older setups
    # reply: pybot               # default: irc.username
    # server_host: irc.example.net  # optional: only match this IRC host
    # server_port: 6697             # optional: only match this IRC port
  sasl:
    enabled: true
    mechanism: auto   # auto | PLAIN | SCRAM-SHA-256
    username: pybot
    password: secret
  channels:
    - "#dev"
  who_poll_seconds: 60
  ison_poll_seconds: 30    # reclaim primary/alt nick when on a fallback
  reconnect:
    enabled: true
    initial_delay: 10      # first retry after 10s
    step: 10               # then 20, 30, … up to max
    max_delay: 60          # then every 60s
  flood:
    burst: 5
    rate: 1.0         # tokens per second
  admin:
    # hostmasks (nick!user@host); * and ? wildcards allowed
    hosts:
      - "*!you@*.example.net"
    accounts:
      - youraccount          # services account (account-tag / WHOX / SASL)
    prefix: "~"
  # Auto-joined channels for IRC admin commands and general bot presence.
  # Module channels are joined separately from each enabled module config.
  channels:
    - "#dev"

http:
  host: 0.0.0.0
  port: 8080

logging:
  level: INFO
  raw_enabled: true
  raw_level: DEBUG
  color: true

modules:
  github_webhook:
    enabled: true
    path: /github
    secret: whsec_change_me
    channel: "#dev"
    emojis: true              # set false if your clients hate unicode
    events:
      - push                 # commits + tag pushes (formatted separately)
      - release              # GitHub Release published (enable in webhook too)
      - issues
      - pull_request

  gardena:
    enabled: false
    client_id: ""             # Husqvarna/Gardena application key
    client_secret: ""
    # Per-channel: omit debug (or debug: false) for normal status only;
    # debug: true also gets noisy state/activity lines.
    channels:
      - name: "#dev"
      # - name: "#lawn"
      #   debug: true
    # command_prefix: "~"     # defaults to irc.admin.prefix
    weather:                  # optional; status-line snippets + ~weather
      enabled: false
      api_key: ""
      location: ""            # display name only
      latitude: 0.0
      longitude: 0.0
      update_seconds: 3600

  medialink:
    enabled: false
    api_key: ""
    api_secret: ""
    server_url: "https://your-livekit-host"   # LiveKit HTTP API URL
    token_url: "https://your-frontend/?token="
    shortener:
      mode: "none"          # none | tinyurl | isgd | local
      timeout_seconds: 4
      tinyurl_endpoint: "https://tinyurl.com/api-create.php"
      isgd_endpoint: "https://is.gd/create.php"
      # local mode serves short links from this bot and redirects to token_url+token.
      # base_url should be the externally reachable bot URL, e.g. https://chat.example.com
      base_url: ""
      path: "/j"            # GET /j?c=<code>
    token_ttl_minutes: 60
    poll_seconds: 30
    # command_prefix: "$"     # defaults to irc.admin.prefix
    announcements:
      enabled: true
      interval_minutes: 15
    webhook:
      enabled: true
      path: /livekit/webhook
      verify: true            # JWT signature via api_secret
    # Room name = IRC channel name for $join
    channels:
      - name: "#routing"
      # - name: "#dev"
      #   debug: true          # also receive noisy track/debug lines
